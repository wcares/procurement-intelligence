<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly refresh at 02:30 local time. Not installed by default; see README "Scheduled refresh".
     REPO_DIR is replaced with the repository path when installing. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.procintel.refresh</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>REPO_DIR/scripts/refresh-nightly.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>REPO_DIR/data/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>REPO_DIR/data/logs/launchd.err</string>
</dict>
</plist>
