# Local model stack for procintel (all optional: with nothing set, search is keyword-only and answers are quoted
# sentences checked by word overlap). Load with:  set -a; . ./.env; set +a
# Every server runs with --sleep-idle-seconds 300: after 5 idle minutes it releases the model's memory (measured on
# Saluki: wired memory 12.6 GB -> 3.6 GB) and the next request wakes it (measured: 1.4 s, the file stays in page cache).
# Every model below is served by llama.cpp (macOS: brew install llama.cpp) and can be swapped for any
# OpenAI-compatible server (Ollama, LM Studio, vLLM) or a hosted API through LiteLLM model strings.

# Data folder (databases, saved settings, trained models, HTTP cache); default <repo>/data. In a container: a volume.
# PROCINTEL_DATA_DIR=/data
# Storage engine; unset = DuckDB files in the data folder. Postgres (several writing processes, e.g. api + workers):
#   python -m procintel.db install            # DuckDB's postgres extension (once, 14.4 MB)
#   python -m procintel.db copy-to-postgres   # copies the local tables into Postgres
# PROCINTEL_DB_URL=postgresql://procintel:procintel@127.0.0.1:5433/procintel
# Vector store; unset = vectors in memory. Qdrant (fill it once with `python -m procintel.vector_index sync`;
# refresh keeps it current):
# PROCINTEL_VECTOR_URL=http://127.0.0.1:6333
# Background jobs: 1 = a worker thread in the backend (default), 0 = none, external = separate worker processes
# (`python -m procintel.jobs.worker`, any number, needs PROCINTEL_DB_URL); the backend reloads when a worker
# changed the data.
# PROCINTEL_JOBS=external

# Answer writer: Underdog-Saluki-27B-1.0 IQ2 (huggingface.co/ConwayResearch/Underdog-Saluki-27B-1.0)
#   llama-server -m Underdog-Saluki-27B-1.0-IQ2-mix.gguf --alias saluki-27b --host 127.0.0.1 --port 8080 -c 8192 -np 1 --sleep-idle-seconds 300
PROCINTEL_LLM_MODEL=openai/saluki-27b
PROCINTEL_LLM_API_BASE=http://127.0.0.1:8080/v1
PROCINTEL_LLM_API_KEY=local
# a reasoning model otherwise spends the whole token budget thinking and returns nothing (measured: finish=length)
PROCINTEL_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
# Faster alternative, measured on the 100-question evaluation (2026-10-25, eval/report-qwen3-8b-q4.md):
# Qwen3-8B Q4_K_M (huggingface.co/Qwen/Qwen3-8B-GGUF, 5.03 GB) answers in 14.8 s median vs 34 s, but 15 of 290 answer
# sentences were unsupported by their sources (Saluki 3 of 285), evidence gate precision 0.81 vs 0.90 and 1 of 20 trap
# questions answered. Swap these two lines (same extra body) to use it:
#   llama-server -m Qwen3-8B-Q4_K_M.gguf --alias qwen3-8b-q4 --host 127.0.0.1 --port 8084 -c 8192 -np 1 --sleep-idle-seconds 300
# PROCINTEL_LLM_MODEL=openai/qwen3-8b-q4
# PROCINTEL_LLM_API_BASE=http://127.0.0.1:8084/v1

# Independent faithfulness judge for the evaluation only (procintel.evaluate): a different model from the answer
# writer, so answers are not graded by the model that wrote them. Qwen3-VL-8B-Instruct GGUF, served text-only.
#   llama-server -m qwen3-vl-8b.gguf --alias qwen3-vl-8b --host 127.0.0.1 --port 8083 -c 8192 -np 1 --sleep-idle-seconds 300
PROCINTEL_JUDGE_MODEL=openai/qwen3-vl-8b
PROCINTEL_JUDGE_API_BASE=http://127.0.0.1:8083/v1
PROCINTEL_JUDGE_API_KEY=local

# Embeddings: EmbeddingGemma 2 Q8_0 (huggingface.co/ggml-org/embeddinggemma-2-GGUF)
#   llama-server -m embeddinggemma-2-Q8_0.gguf --embedding --alias embeddinggemma-2 --host 127.0.0.1 --port 8081 \
#                -c 8192 -b 2048 -ub 2048 -np 4 --sleep-idle-seconds 300
PROCINTEL_EMBED_MODEL=openai/embeddinggemma-2
PROCINTEL_EMBED_API_BASE=http://127.0.0.1:8081/v1
PROCINTEL_EMBED_DIM=256

# Decision model: Laya Q8_0 (huggingface.co/ggml-org/Laya-GGUF), served by llama-server's /v1/systemone
#   llama-server -m Laya-Q8_0.gguf --alias laya --host 127.0.0.1 --port 8082 -c 8192 -b 2048 -ub 2048 -np 1 --sleep-idle-seconds 300
# -ub must cover a whole passage (one passage of 519 tokens failed at the default 512)
PROCINTEL_DECIDE_API_BASE=http://127.0.0.1:8082
