# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Data: regenerate with `python -m procintel.ingestion.ingest && python -m procintel.ingestion.tables`
data/cache/
data/*.duckdb
data/*.duckdb.wal
data/raw/
# prompt versions saved from the Settings page (runtime state)
data/prompts/
# pipeline rules edited on the Settings page (runtime state; absent = the defaults)
data/pipeline_rules.json
# salt of the pseudonymous user ids in the logs (secret: with it the ids could be linked back to usernames)
data/auth_salt
# uploaded files (procintel.intake)
data/uploads/

# Next.js (web/ also has its own .gitignore)
web/node_modules/
web/.next/
web/next-env.d.ts

# OS / env
.DS_Store
.env
.env.*
.venv-py39
!.env.example
data/models/
data/config*.json
